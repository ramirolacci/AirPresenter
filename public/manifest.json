{
  "manifest_version": 3,
  "name": "AirPresenter — Live Gesture AR Canvas",
  "version": "1.0.0",
  "description": "Pizarra aumentada en vivo sobre la webcam controlada por gestos para videollamadas (Google Meet, Zoom, Teams), grabaciones y presentaciones.",
  "action": {
    "default_title": "Abrir AirPresenter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "mediapipe/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}

